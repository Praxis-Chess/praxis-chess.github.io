# The dev server and the generators. Nothing at runtime reads either, and the
# site is complete without them — but they are how assets/ is reproduced, so
# they are NOT ignored. Only their debris is.
__pycache__/
*.pyc

.DS_Store
Thumbs.db
desktop.ini

# Editor and host scratch
.vscode/
.idea/
.vercel/
.netlify/

# NOT ignored, deliberately: assets/. Every file in it is generated by
# tools/make-assets.py, and a deploy that runs no build step has to find them
# already committed. Regenerate with the script; do not hand-edit.
